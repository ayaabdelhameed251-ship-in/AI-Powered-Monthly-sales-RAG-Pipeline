        "jsCode": "const newItem = [];\nfor (const item of $input.all()) {\n  const binaryKeys = Object.keys(item.binary || {});\n  const binaryKey = binaryKeys[0];\n  \n  let newBinary = {};\n  if (binaryKey) {\n    newBinary = {\n      data: item.binary[binaryKey]\n    };\n  }\n  \n  newItem.push({\n    json: item.json,\n    binary: newBinary\n  });\n}\nreturn newItem;"
